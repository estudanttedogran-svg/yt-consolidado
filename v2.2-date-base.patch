diff --git a/tests/test_radar.py b/tests/test_radar.py
index e61303e..eb6fd5b 100644
--- a/tests/test_radar.py
+++ b/tests/test_radar.py
@@ -299,3 +299,35 @@ def test_report_displays_total_near_misses_not_only_sample(build):
     assert rep["candidate_counts"]["near_miss"]==25
     assert len(rep["near_misses"])==20
     assert "25 candidatos no total; 20 exibidos" in markdown(rep)
+
+
+def test_resume_uses_original_research_date_instead_of_current_clock(ready):
+    from datetime import timedelta
+    from conftest import NOW
+    r,s=ready
+    jid=job(r)
+    r.continue_job(jid,1)  # discover on Nov 7
+    assert r.status(jid)["searches_done"]==1
+    r.clock=lambda:NOW+timedelta(days=21)
+    finish(r,jid)
+    report=r.results(jid)
+    assert len(report["channels"])==1
+    assert report["channels"][0]["first_public_video_published_at"]==iso(3)
+    assert report["channels"][0]["days_since_first_public_video"]<14
+    assert report["research_as_of"].startswith("2026-11-07")
+    assert "Data-base da pesquisa" in markdown(report)
+
+
+def test_legacy_job_without_research_as_of_uses_created_at(ready):
+    from datetime import timedelta
+    from conftest import NOW
+    r,s=ready
+    jid=job(r)
+    state=r.store.get_job(jid)
+    state.pop("research_as_of")
+    state["created_at"]=NOW.isoformat()
+    r.store.save_job(state)
+    r.clock=lambda:NOW+timedelta(days=30)
+    finish(r,jid)
+    assert len(r.results(jid)["channels"])==1
+    assert r.results(jid)["research_as_of"].startswith("2026-11-07")
